{
  "name": "@local/review-desk",
  "version": "1.1.3",
  "private": true,
  "type": "module",
  "description": "ShenYue (审悦) for DeepSeek Harness: a three-column manuscript review workspace that runs source checks, logic review, expansion, connection analysis, and free-form rewrites on a selected passage, keeps every result, imports .docx/.pdf, and can install its WPS add-in on this machine.",
  "license": "MIT",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "docs",
    "icon.svg",
    "wps-addin",
    "scripts"
  ],
  "scripts": {
    "test": "cd tests && npm install --no-audit --no-fund && node host-test.mjs && node client-test.mjs",
    "wps:install": "node scripts/install-wps-addin.mjs install",
    "wps:status": "node scripts/install-wps-addin.mjs status",
    "wps:uninstall": "node scripts/install-wps-addin.mjs uninstall"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "manuscript",
    "review",
    "docx",
    "pdf"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lzyxczw-cyber/dsh-review-desk.git"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  }
}
